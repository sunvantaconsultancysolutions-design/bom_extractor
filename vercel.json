{
  "version": 2,
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "30mb",
        "runtime": "python3.12",
        "maxDuration": 30
      }
    }
  ],
  "routes": [
    { "src": "/favicon.ico", "dest": "main.py" },
    { "src": "/api/(.*)",    "dest": "main.py" },
    { "src": "/(.*)",        "dest": "main.py" }
  ],
  "env": {
    "PYTHONUNBUFFERED": "1"
  }
}
